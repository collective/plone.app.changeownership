graft src/plone
global-exclude *.pyc

include pyproject.toml
include CHANGES.md
include CONTRIBUTORS.md
include docs/LICENSE.GPL
include docs/LICENSE.txt

exclude *.coveragerc
exclude *.testing
exclude *.development
exclude tox.ini
exclude *.txt
exclude .gitlab-ci.yml
exclude news
exclude .env
exclude instance.yaml

recursive-exclude scss *
recursive-exclude sass *
recursive-exclude jinja *
recursive-exclude resources *
recursive-exclude news *