<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@prefs_main_template/macros/master"
      xml:lang="en"
      i18n:domain="plone.app.changeownership"
>

  <body>

    <div metal:fill-slot="prefs_configlet_main">

      <dl class="portalMessage"
          tal:condition="view/status"
      >
        <tal:repeat repeat="msg view/status">
          <dt i18n:translate="">Info</dt>
          <dd tal:content="msg">Message</dd>
        </tal:repeat>
      </dl>

      <h1 class="documentFirstHeading"
          i18n:translate=""
      >Change Ownership</h1>

      <div class="documentDescription"
           i18n:translate=""
      >
      This form will help you to pass ownership of objects owned by old users to a new user.
      </div>

      <form action="./change-owner"
            method="post"
      >

        <div class="mb-3">
          <label class="form-label"
                 for="path"
                 i18n:translate=""
          >Path filter</label>
          <input class="form-control"
                 id="path"
                 aria-describedby="pathHelpBlock"
                 name="path"
                 size="50"
                 type="text"
                 tal:attributes="
                   value view/path_filter;
                 "
          />
          <div class="form-text"
               id="pathHelpBlock"
               i18n:translate="path_help"
          >Insert an absolute path starting from the portal root (for example: '/events'). Only contents inside this subtree will be touched.</div>
        </div>

        <div class="mb-3">

          <label class="form-label"
                 for="oldowners"
                 i18n:translate=""
          >The old owners:</label><br />
          <select class="form-select"
                  id="oldowners"
                  multiple="multiple"
                  name="oldowners"
          >
            <tal:loop tal:repeat="author view/list_authors">
              <option tal:content="author/name"
                      tal:attributes="
                        value author/id;
                        selected author/selected;
                      "
              >author</option>
            </tal:loop>
          </select>

        </div>

        <div class="mb-3">

          <label class="form-label"
                 for="newowner"
                 i18n:translate=""
          >The new owner:</label>
          <select class="form-select"
                  id="newowner"
                  name="newowner"
          >
            <tal:loop tal:repeat="member view/list_members">
              <option tal:content="member/name"
                      tal:attributes="
                        value member/id;
                        selected member/selected;
                      "
              >member</option>
            </tal:loop>
          </select>

        </div>

        <div class="mb-3">


          <input class="form-check-input"
                 id="delete_old_creators"
                 name="delete_old_creators:boolean"
                 type="checkbox"
                 tal:attributes="
                   checked view/delete_old_creators;
                 "
          />
          <label class="form-check-label"
                 for="delete_old_creators"
                 i18n:translate=""
          >Remove old owners from the creators list</label>

        </div>

        <div class="mb-3">

          <input class="form-check-input"
                 id="delete_old_owners"
                 name="delete_old_owners:boolean"
                 type="checkbox"
                 tal:attributes="
                   checked view/delete_old_owners;
                 "
          />
          <label class="form-check-label"
                 for="delete_old_owners"
                 i18n:translate=""
          >Remove the 'owner role' for the old owners</label>

        </div>

        <div class="mb-3">


          <input class="form-check-input"
                 id="exclude_members_folder"
                 name="exclude_members_folder:boolean"
                 type="checkbox"
                 tal:attributes="
                   checked view/exclude_members_folder;
                 "
          />
          <label class="form-check-label"
                 for="exclude_members_folder"
                 i18n:translate=""
          >Exclude members folder</label>

        </div>
        <div class="mb-3">

          <input class="form-check-input"
                 id="change_modification_date"
                 name="change_modification_date:boolean"
                 type="checkbox"
                 tal:attributes="
                   checked view/change_modification_date;
                 "
          />
          <label class="form-check-label"
                 for="change_modification_date"
                 i18n:translate=""
          >Change the modification date</label>

        </div>
        <div class="mb-3">


          <input class="form-check-input"
                 id="dry_run"
                 name="dry_run:boolean"
                 type="checkbox"
                 tal:attributes="
                   checked view/dry_run;
                 "
          />
          <label class="form-check-label"
                 for="dry_run"
                 i18n:translate=""
          >Perform as Dry Run</label>

        </div>

        <div class="mb-3">

          <input class="btn btn-primary"
                 name="submit"
                 type="submit"
                 value="Change Ownership"
                 i18n:attributes="value"
          />

        </div>

      </form>

    </div>

  </body>
</html>
