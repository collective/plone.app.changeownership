<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="plone.app.changeownership"
    >

  <browser:page
      name="change-ownership-controlpanel"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".controlpanel.ChangeOwnershipControlPanelView"
      permission="plone.app.changeownership.ManageOwnership"
      layer="plone.app.changeownership.interfaces.IBrowserLayer"
      />



  <utility
      name="plone.app.changeownership.Oldowners"
      component=".vocabularies.OldOwnerFactory"
      />

  <utility
      name="plone.app.changeownership.Newowners"
      component=".vocabularies.NewOwnerFactory"
      />


</configure>
